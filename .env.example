# Salin file ini menjadi .env.local lalu isi nilainya.
# Panduan lengkap ada di README.md bagian "Setup".

# --- Supabase (Project Settings > API) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- App ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Catatan Admin ---
# Tidak ada lagi variabel ADMIN_EMAILS. Status admin disimpan di database
# (tabel profiles, kolom role = 'admin') dan dikelola lewat halaman
# /admin > "Kelola Admin". Admin pemilik (owner) diatur langsung di DB.

# --- Email transaksional (Resend) ---
# Kosongkan RESEND_API_KEY untuk mematikan fitur email (graceful no-op).
# Tanpa domain terverifikasi, from memakai onboarding@resend.dev (sandbox).
RESEND_API_KEY=
NOTIFY_FROM=KaryaDiaspora <onboarding@resend.dev>
