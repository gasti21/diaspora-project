# Salin file ini menjadi .env.local lalu isi nilainya.
# Panduan lengkap ada di README.md bagian "Setup".

# --- Supabase (Project Settings > API) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Admin ---
# Daftar email pengurus yang boleh membuka /admin, pisahkan dengan koma.
# Kosongkan saat development untuk bisa membuka /admin tanpa cek email.
ADMIN_EMAILS=

# --- App ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
